// LIVE message: shown to every version, on every launch, not suppressible.
// Tells users this is an unofficial port and routes bug reports AWAY from the
// official BAR/Recoil trackers and from the original port's tracker to this
// fork's GitHub issues.
{
  "id": "unofficial-build",
  "date": "2026-08-24",
  "target": {
    "op": "all"
  },
  "title": "Unofficial Build",
  "body": [
    "<p style='font-family:-apple-system;font-size:13px'>",
    "This is an <b>unofficial port</b> of the Recoil engine and the game ",
    "Beyond All Reason to macOS — a fork of benbreen's port with extra ",
    "fixes. It is not made or supported by the Beyond All Reason or Recoil teams.",
    "</p>",
    "<p style='font-family:-apple-system;font-size:13px'>",
    "<b>Please do not report problems with this build to the official Beyond ",
    "All Reason bug tracker or Discord</b>, or to the original port's tracker ",
    "— they cannot help with issues caused by this build.",
    "</p>",
    "<p style='font-family:-apple-system;font-size:13px'>",
    "Send feedback and bug reports here:<br>",
    "<a href='https://github.com/Vandomas/RecoilEngine-AppleSilicon/issues'>",
    "github.com/Vandomas/RecoilEngine-AppleSilicon/issues</a>",
    "</p>"
  ],
  "frequency": "always",
  "buttons": [
    {
      "label": "Report Feedback / Bugs",
      "action": "open-url",
      "url": "https://github.com/Vandomas/RecoilEngine-AppleSilicon/issues",
      "then": "stay"
    },
    {
      "label": "Continue",
      "action": "continue",
      "default": true
    }
  ]
}
